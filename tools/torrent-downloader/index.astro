---
import { resolveLocale } from "@workspace/tool-sdk"
import { ToolPageShell } from "@workspace/ui/components/tool/tool-page-shell"
import { ToolArticle } from "@workspace/ui/components/tool/tool-article"
import { FileText, Magnet } from "@workspace/ui/icons"
import Client from "./client"
import type { AstroComponentFactory } from "astro/runtime/server/index.js"
import type { ToolMeta } from "@workspace/tool-sdk"
import type EnglishMessages from "./messages/en.json"

interface Props { lang: string }

const { lang } = Astro.props
const meta = resolveLocale<ToolMeta>(
  import.meta.glob("./meta/*.json", { eager: true, import: "default" }),
  lang
)!
const messages = resolveLocale<typeof EnglishMessages>(
  import.meta.glob("./messages/*.json", { eager: true, import: "default" }),
  lang
)!
const Intro = resolveLocale<AstroComponentFactory>(
  import.meta.glob("./sections/intro/*.md", { eager: true, import: "default" }),
  lang
)!
const prefix = lang === "en" ? "" : `/${lang}`
const related = [
  { slug: "magnet-link-viewer", name: messages.magnetViewer, Icon: Magnet },
  { slug: "torrent-file-viewer", name: messages.torrentViewer, Icon: FileText },
]
---

<ToolPageShell title={meta.name} description={meta.description}>
  <Client client:load language={lang} messages={messages} />
  <div class="flex flex-wrap gap-x-6 gap-y-2">
    {related.map(({ slug, name, Icon }) => (
      <a href={`${prefix}/tools/${slug}/`} class="inline-flex min-h-8 items-center gap-2 rounded-sm text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">
        <Icon className="size-4 shrink-0" aria-hidden="true" />
        {name}
      </a>
    ))}
  </div>
  <ToolArticle className="[&_code]:[direction:ltr] [&_code]:[unicode-bidi:isolate]">
    <Intro />
  </ToolArticle>
</ToolPageShell>
