---
import { resolveLocale } from "@workspace/tool-sdk"
import { ToolArticle } from "@workspace/ui/components/tool/tool-article"
import { ToolPageShell } from "@workspace/ui/components/tool/tool-page-shell"
import GpuInformationClient from "./client"

import type { ToolMeta } from "@workspace/tool-sdk"
import type { GpuMessages } from "./types"

interface Props {
  lang: string
}

const { lang } = Astro.props

const meta = resolveLocale<ToolMeta>(
  import.meta.glob("./meta/*.json", { eager: true, import: "default" }),
  lang
)!
const messages = resolveLocale<GpuMessages>(
  import.meta.glob("./messages/*.json", { eager: true, import: "default" }),
  lang
)!
const deviceHref = (lang === "en" ? "" : `/${lang}`) + "/tools/device-information/"
---

<ToolPageShell title={meta.name} description={meta.description}>
  <div class="grid min-w-0 gap-3">
    <a href="#gpu-report-guide" class="w-fit text-sm underline underline-offset-4">
      {messages.aboutTitle}
    </a>
    <GpuInformationClient client:load messages={messages} />
  </div>
  <ToolArticle>
    <h2 id="gpu-report-guide" class="scroll-mt-24">{messages.aboutTitle}</h2>
    <p>{messages.aboutDescription}</p>
    <h3>{messages.webGlTitle}</h3>
    <p>{messages.webGlDescription}</p>
    <h3>{messages.rendererHelpTitle}</h3>
    <p>{messages.rendererHelpDescription}</p>
    <h3>{messages.limitsHelpTitle}</h3>
    <p>{messages.limitsHelpDescription}</p>
    <h3>{messages.usageTitle}</h3>
    <ol>
      <li>{messages.usageStep1}</li>
      <li>{messages.usageStep2}</li>
      <li>{messages.usageStep3}</li>
    </ol>
    <h3>{messages.troubleshootingTitle}</h3>
    <p>{messages.troubleshootingDescription}</p>
    <h3>{messages.monitoringTitle}</h3>
    <p>{messages.monitoringDescription}</p>
    <p>
      <a href={deviceHref}>{messages.deviceInformation}</a>
      ·
      <a href="https://developer.mozilla.org/en-US/docs/Web/API/WebGL_API">
        {messages.webglReference}
      </a>
    </p>
  </ToolArticle>
</ToolPageShell>
