---
import { resolveLocale } from "@workspace/tool-sdk"
import type { ToolMeta } from "@workspace/tool-sdk"
import type { AstroComponentFactory } from "astro/runtime/server/index.js"
import { ToolPageShell } from "@workspace/ui/components/tool/tool-page-shell"
import { ToolArticle } from "@workspace/ui/components/tool/tool-article"
import Client from "./client"
import type { Messages } from "./types"

interface Props { lang: string }
const { lang } = Astro.props
const meta = resolveLocale<ToolMeta>(import.meta.glob("./meta/*.json", { eager: true, import: "default" }), lang)!
const messages = resolveLocale<Messages>(import.meta.glob("./messages/*.json", { eager: true, import: "default" }), lang)!
const Intro = resolveLocale<AstroComponentFactory>(import.meta.glob("./sections/intro/*.md", { eager: true, import: "default" }), lang)!
---
<ToolPageShell title={meta.name} description={meta.description}>
  <Client client:load messages={messages} />
  <ToolArticle className="wrap-anywhere"><Intro /></ToolArticle>
</ToolPageShell>
