---
import { makeToolHref } from "@workspace/mac-address"
import { resolveLocale } from "@workspace/tool-sdk"
import { ToolArticle } from "@workspace/ui/components/tool/tool-article"
import { ToolPageShell } from "@workspace/ui/components/tool/tool-page-shell"
import type { ToolMeta } from "@workspace/tool-sdk"
import Client from "./client"
import type EnglishMessages from "./messages/en.json"

interface Props { lang: string }
const { lang } = Astro.props
const meta = resolveLocale<ToolMeta>(
  import.meta.glob("./meta/*.json", { eager: true, import: "default" }), lang
)!
const messages = resolveLocale<typeof EnglishMessages>(
  import.meta.glob("./messages/*.json", { eager: true, import: "default" }), lang
)!
---

<ToolPageShell title={meta.name} description={meta.description}>
  <Client client:load language={lang} messages={messages} />
  <ToolArticle>
    <h2>{messages.about.title}</h2>
    <p>{messages.about.intro}</p>
    {messages.about.sections.map((section) => (
      <section>
        <h3>{section.title}</h3>
        <p>{section.body}</p>
      </section>
    ))}
  </ToolArticle>
  <nav aria-label={messages.navigationLabel} class="border-t pt-6">
    <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
      <li>
        <a class="rounded-sm underline underline-offset-4 hover:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring" href={makeToolHref(lang, "mac-address-lookup")}>{messages.lookup}</a>
      </li>
      <li>
        <a class="rounded-sm underline underline-offset-4 hover:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring" href={makeToolHref(lang, "mac-address-vendor-lookup")}>{messages.vendors}</a>
      </li>
    </ul>
  </nav>
</ToolPageShell>
