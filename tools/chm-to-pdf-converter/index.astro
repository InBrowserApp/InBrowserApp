---
import { resolveLocale } from "@workspace/tool-sdk"
import type { ToolMeta } from "@workspace/tool-sdk"
import { ToolPageShell } from "@workspace/ui/components/tool/tool-page-shell"
import { ToolArticle } from "@workspace/ui/components/tool/tool-article"
import Client from "./client"
import type Messages from "./messages/en.json"

interface Props { lang: string }
const { lang } = Astro.props
const meta = resolveLocale<ToolMeta>(import.meta.glob("./meta/*.json", { eager: true, import: "default" }), lang)!
const { article, ...messages } = resolveLocale<typeof Messages>(import.meta.glob("./messages/*.json", { eager: true, import: "default" }), lang)!
---
<ToolPageShell title={meta.name} description={meta.description}>
  <Client client:load messages={messages} lang={lang} />
  <ToolArticle>
    <h2>{article.howTitle}</h2>
    <ol class="ps-2">
      <li>{article.chooseStep}</li>
      <li>{article.waitStep}</li>
      <li>{article.downloadStep}</li>
    </ol>
    <h2>{article.whatTitle}</h2>
    <p>{article.what}</p>
    <h2>{article.layoutTitle}</h2>
    <p>{article.layout}</p>
    <h2>{article.privacyTitle}</h2>
    <p>{article.privacy}</p>
    <p><a href="../chm-viewer/">{article.viewer}</a></p>
  </ToolArticle>
</ToolPageShell>
