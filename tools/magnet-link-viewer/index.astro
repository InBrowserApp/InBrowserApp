---
import { resolveLocale } from "@workspace/tool-sdk"
import TorrentPage from "@workspace/ui/astro/torrent-page"
import { getTorrentMessages } from "@workspace/ui/torrent-messages"
import Client from "./client"
import type { AstroComponentFactory } from "astro/runtime/server/index.js"
import type { ToolMeta } from "@workspace/tool-sdk"
import type EnglishMessages from "./messages/en.json"

interface Props { lang: string }

const { lang } = Astro.props
const meta = resolveLocale<ToolMeta>(
  import.meta.glob("./meta/*.json", { eager: true, import: "default" }),
  lang
)!
const messages = resolveLocale<typeof EnglishMessages>(
  import.meta.glob("./messages/*.json", { eager: true, import: "default" }),
  lang
)!
const Intro = resolveLocale<AstroComponentFactory>(
  import.meta.glob("./sections/intro/*.md", { eager: true, import: "default" }),
  lang
)!
---

<TorrentPage lang={lang} meta={meta} related={messages.related} relatedSlug="torrent-file-viewer">
  <Client client:load language={lang} messages={messages} shared={getTorrentMessages(lang)} />
  <Intro slot="intro" />
</TorrentPage>
