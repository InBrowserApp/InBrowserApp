---
import { resolveLocale, type ToolMeta } from "@workspace/tool-sdk"
import ComicArchiveTool from "@workspace/ui/astro/comic-archive-tool"

interface Props {
  lang: string
}

const { lang } = Astro.props
const meta = resolveLocale<ToolMeta>(
  import.meta.glob("./meta/*.json", { eager: true, import: "default" }),
  lang
)!
---

<ComicArchiveTool lang={lang} meta={meta} kind="cb7" />
