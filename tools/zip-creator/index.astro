---
import { resolveLocale } from "@workspace/tool-sdk"
import { ToolPageShell } from "@workspace/ui/components/tool/tool-page-shell"
import { buttonVariants } from "@workspace/ui/components/ui/button"
import { cn } from "@workspace/ui/lib/utils"
import ZipCreator from "./client"

import type { ToolMeta } from "@workspace/tool-sdk"
import type { Messages } from "./types"

interface Props {
  lang: string
}

const { lang } = Astro.props

const meta = resolveLocale<ToolMeta>(
  import.meta.glob("./meta/*.json", { eager: true, import: "default" }),
  lang
)!
const messages = resolveLocale<Messages>(
  import.meta.glob("./messages/*.json", { eager: true, import: "default" }),
  lang
)!
const viewerHref =
  lang === "en" ? "/tools/archive-viewer/" : "/" + lang + "/tools/archive-viewer/"
---

<ToolPageShell title={meta.name} description={meta.description}>
  <ZipCreator client:load messages={messages} lang={lang} />
  <div class="mt-6">
    <a href={viewerHref} class={cn(buttonVariants({ variant: "link" }), "h-auto max-w-full whitespace-normal text-start")}
      >{messages.viewerLink}</a
    >
  </div>
</ToolPageShell>
