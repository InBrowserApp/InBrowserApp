{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "import",
    "react",
    "jsx-a11y",
    "typescript",
    "unicorn",
    "oxc",
    "vitest",
    "promise"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // Preserve the lint policy from oxlint 1.58. These newly enabled rules
    // require a separate React compiler and accessibility policy migration.
    "react/immutability": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
    "jsx-a11y/no-redundant-roles": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "max-lines": [
      "error",
      { "max": 300, "skipBlankLines": true, "skipComments": true }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/tests/**"],
      "rules": {
        "max-lines": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/no-standalone-expect": [
          "error",
          { "additionalTestBlockFunctions": ["beforeEach", "afterEach"] }
        ],
        "vitest/valid-expect": "error",
        "vitest/expect-expect": [
          "error",
          {
            "assertFunctionNames": [
              "expect*",
              "screen.findBy*",
              "screen.findAllBy*",
              "screen.getBy*",
              "screen.getAllBy*"
            ]
          }
        ],
        "vitest/require-to-throw-message": "error"
      }
    },
    {
      "files": ["packages/tool-registry/src/generated/**"],
      "rules": {
        "max-lines": "off"
      }
    }
  ],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "dist/**",
    ".astro/**",
    ".turbo/**",
    ".agents/**",
    ".playwright-cli/**",
    "coverage/**",
    "tools/pdf-to-pdfa-converter/engine/generated/fynepdf.mjs",
    "tools/github-actions-workflow-validator/engine/vendor/wasm_exec.js",
    "node_modules/**"
  ],
  "settings": {
    "react": {
      "version": "19.2.4"
    }
  }
}
