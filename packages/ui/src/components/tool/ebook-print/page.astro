---
import { resolveLocale, type ToolMeta } from "@workspace/tool-sdk"
import { ToolPageShell } from "../tool-page-shell"
import Client, { type BookPrintFormat } from "./client"
import type { FormatCopy, Messages } from "./messages"

type Props = { lang: string; meta: ToolMeta } & (
  | { format: "epub"; copy?: never }
  | { format: Exclude<BookPrintFormat, "epub">; copy: FormatCopy }
)

const { lang, meta, format, copy } = Astro.props
const base = resolveLocale<Messages>(
  import.meta.glob("./messages/*.json", { eager: true, import: "default" }),
  lang
)!
const messages = { ...base, ...copy }
---

<ToolPageShell title={meta.name} description={meta.description}>
  <Client client:load lang={lang} format={format} messages={messages} />
  <slot />
</ToolPageShell>
