---
import { resolveLocale, type ToolMeta } from "@workspace/tool-sdk"
import { ToolPageShell } from "../tool-page-shell"
import Client from "./client"
import type { Messages, ComicPdfFormat } from "./types"
import { comicArchiveFormats } from "../comic-reader/archive-formats"
import type archiveEnglish from "../comic-reader/archive-copy/en.json"

interface Props {
  lang: string
  meta: ToolMeta
  format: ComicPdfFormat
}

const { lang, meta, format } = Astro.props
const base = resolveLocale<Messages>(
  import.meta.glob("./messages/*.json", { eager: true, import: "default" }),
  lang
)!
let messages = base
if (format !== "cbz") {
  const archive = resolveLocale<typeof archiveEnglish>(
    import.meta.glob("../comic-reader/archive-copy/*.json", {
      eager: true,
      import: "default",
    }),
    lang
  )!
  const { label, archive: archiveLabel } = comicArchiveFormats[format]
  const text = (value: string) =>
    value.replaceAll("{format}", label).replaceAll("{archive}", archiveLabel)
  messages = {
    ...base,
    open: text(archive.choose),
    drop: text(archive.drop),
    invalid: text(archive.invalid),
    privacy: archive.privacy,
    pdfExport: { ...base.pdfExport, damaged: text(archive.damaged) },
  }
}
---

<ToolPageShell title={meta.name} description={meta.description}>
  <Client client:load messages={messages} format={format} />
  <slot />
  {format !== "cbz" && (
    <p class="text-xs text-muted-foreground">
      <a href="/licenses/archive-viewer.txt">libarchive</a>
    </p>
  )}
</ToolPageShell>
