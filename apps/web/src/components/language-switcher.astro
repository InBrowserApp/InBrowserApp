---
import { Check, Languages } from "@workspace/ui/icons"
import { getLanguageNativeName } from "@workspace/ui/lib/language-native-names"
import NavbarDropdown from "./navbar-dropdown.astro"

interface Props {
  label: string
  options: readonly {
    code: string
    href: string
    label?: string
    current?: boolean
  }[]
}

const { label, options } = Astro.props
const sortedOptions = [...options].sort(
  (a, b) => Number(!!b.current) - Number(!!a.current)
)
---

<NavbarDropdown label={label}>
  <Languages slot="icon" className="size-4" />
  <div data-language-options>
    {
      sortedOptions.map((option) => (
        <a
          data-dropdown-item
          href={option.href}
          hreflang={option.code}
          lang={option.code}
          aria-current={option.current ? "true" : undefined}
        >
          {option.label ?? getLanguageNativeName(option.code)}
          {option.current && (
            <Check className="pointer-events-none absolute end-2 size-4" />
          )}
        </a>
      ))
    }
  </div>
</NavbarDropdown>

<script>
  import { snoozeLanguageSuggestion } from "@workspace/ui/lib/language-preference"
  import { resolvePreferredLanguageCode } from "@workspace/ui/lib/resolve-preferred-language"

  const container = document.querySelector<HTMLElement>("[data-language-options]")
  if (container) {
    const links = [...container.querySelectorAll<HTMLAnchorElement>("a[hreflang]")]
    const preferred = resolvePreferredLanguageCode(
      links.map((link) => link.hreflang),
      navigator.languages?.length ? navigator.languages : [navigator.language]
    )
    const currentLink = links.find((link) => link.hasAttribute("aria-current"))
    const preferredLink = links.find((link) => link.hreflang === preferred)
    if (preferredLink && preferredLink !== currentLink) {
      if (currentLink) currentLink.after(preferredLink)
      else container.prepend(preferredLink)
    }

    function syncLocationSuffix() {
      for (const link of links) {
        link.search = window.location.search
        link.hash = window.location.hash
      }
    }

    syncLocationSuffix()
    container.closest("details")?.addEventListener("toggle", syncLocationSuffix)
    container.addEventListener("click", snoozeLanguageSuggestion)
  }
</script>
