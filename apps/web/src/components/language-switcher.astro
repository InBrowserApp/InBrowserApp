---
import { Check, Languages } from "@workspace/ui/icons"
import { getLanguageNativeName } from "@workspace/ui/lib/language-native-names"
import NavbarDropdown from "./navbar-dropdown.astro"

interface Props {
  label: string
  options: readonly {
    code: string
    href: string
    label?: string
    current?: boolean
  }[]
}

const { label, options } = Astro.props
const sortedOptions = [...options].sort(
  (a, b) => Number(!!b.current) - Number(!!a.current)
)
---

<NavbarDropdown label={label}>
  <Languages slot="icon" className="size-4" />
  <div data-language-options>
    {
      sortedOptions.map((option) => (
        <a
          data-dropdown-item
          href={option.href}
          hreflang={option.code}
          lang={option.code}
          aria-current={option.current ? "true" : undefined}
        >
          {option.label ?? getLanguageNativeName(option.code)}
          {option.current && (
            <Check className="pointer-events-none absolute end-2 size-4" />
          )}
        </a>
      ))
    }
  </div>
</NavbarDropdown>

<script>
  import { snoozeLanguageSuggestion } from "@workspace/ui/lib/language-preference"
  import { resolvePreferredLanguageCode } from "@workspace/ui/lib/resolve-preferred-language"

  function sortLanguageOptions() {
    document
      .querySelectorAll<HTMLElement>("[data-language-options]")
      .forEach((container) => {
        const links = [
          ...container.querySelectorAll<HTMLAnchorElement>("a[hreflang]"),
        ]
        const preferred = resolvePreferredLanguageCode(
          links.map((link) => link.hreflang),
          navigator.languages?.length ? navigator.languages : [navigator.language]
        )
        const rank = (link: HTMLAnchorElement) =>
          link.hasAttribute("aria-current") ? 0 : link.hreflang === preferred ? 1 : 2
        links
          .sort((a, b) => rank(a) - rank(b))
          .forEach((link) => container.append(link))
      })
  }

  sortLanguageOptions()
  document.addEventListener("astro:page-load", sortLanguageOptions)
  document.addEventListener("click", (event) => {
    if (
      event.target instanceof Element &&
      event.target.closest("[data-language-options] a")
    ) {
      snoozeLanguageSuggestion()
    }
  })
</script>
