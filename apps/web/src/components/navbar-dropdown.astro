---
interface Props {
  label: string
}

const { label } = Astro.props
---

<details class="relative" data-navbar-dropdown name="navbar-menu">
  <summary
    class="flex size-7 cursor-pointer list-none items-center justify-center rounded-lg outline-none select-none hover:bg-muted focus-visible:ring-3 focus-visible:ring-ring/50 dark:hover:bg-muted/50"
  >
    <slot name="icon" />
    <span class="sr-only">{label}</span>
  </summary>
  <div
    class="dropdown-content absolute end-0 top-full z-50 mt-1 min-w-32 overflow-y-auto rounded-lg bg-popover p-1 text-popover-foreground shadow-md ring-1 ring-foreground/10"
  >
    <slot />
  </div>
</details>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  .dropdown-content {
    max-height: min(32rem, 70dvh);
    max-width: calc(100vw - 2rem);
    opacity: 0;
    transform: translateY(-0.5rem) scale(0.95);
    transform-origin: top right;
    transition: opacity 100ms ease-out, transform 100ms ease-out;
  }

  /* Keep the native disclosure visible until the exit transition finishes. */
  details::details-content {
    transition: content-visibility 100ms allow-discrete;
  }

  details[open] .dropdown-content {
    opacity: 1;
    transform: none;
  }

  .dropdown-content:dir(rtl) {
    transform-origin: top left;
  }

  @starting-style {
    details[open] .dropdown-content {
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.95);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    details::details-content,
    .dropdown-content {
      transition: none;
    }
  }

  .dropdown-content :global([data-dropdown-item]) {
    display: flex;
    position: relative;
    align-items: center;
    gap: 0.375rem;
    width: 100%;
    padding-block: 0.25rem;
    padding-inline: 0.375rem 2rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    white-space: nowrap;
    cursor: pointer;
    outline: none;
  }

  .dropdown-content :global([data-dropdown-item]:is(:hover, :focus-visible)) {
    background: var(--accent);
    color: var(--accent-foreground);
  }
</style>

<script>
  const selector = "details[data-navbar-dropdown]"

  function closeDropdown(dropdown: HTMLDetailsElement, restoreFocus = false) {
    dropdown.open = false
    if (restoreFocus) dropdown.querySelector("summary")?.focus()
  }

  function dismissDropdowns(event: Event) {
    const target = event.target
    if (!(target instanceof Element)) return

    document
      .querySelectorAll<HTMLDetailsElement>(`${selector}[open]`)
      .forEach((dropdown) => {
        if (!dropdown.contains(target)) closeDropdown(dropdown)
        else if (event.type === "click" && target.closest("[data-dropdown-item]")) {
          closeDropdown(dropdown, true)
        }
      })
  }

  document.addEventListener("click", dismissDropdowns)
  document.addEventListener("focusin", dismissDropdowns)

  document.addEventListener("keydown", (event) => {
    if (!(event.target instanceof Element)) return
    const dropdown = event.target.closest<HTMLDetailsElement>(selector)
    if (!dropdown) return

    if (event.key === "Escape" && dropdown.open) {
      event.preventDefault()
      closeDropdown(dropdown, true)
      return
    }

    if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) return
    const items = [
      ...dropdown.querySelectorAll<HTMLElement>("[data-dropdown-item]"),
    ]
    if (!items.length) return
    event.preventDefault()
    dropdown.open = true
    const index = items.indexOf(document.activeElement as HTMLElement)
    let next = 0
    if (event.key === "End") next = items.length - 1
    else if (event.key === "ArrowDown") next = (index + 1) % items.length
    else if (event.key === "ArrowUp") {
      next = index < 0 ? items.length - 1 : (index - 1 + items.length) % items.length
    }
    items[next]?.focus()
  })
</script>
