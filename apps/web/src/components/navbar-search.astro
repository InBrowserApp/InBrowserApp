---
import { buttonVariants } from "@workspace/ui/components/ui/button"
import { ArrowRight, Search, X } from "@workspace/ui/icons"
import { cn } from "@workspace/ui/lib/utils"
import type { SiteLanguage } from "@/lib/site"
import { loadSiteMessages } from "@/lib/site-messages"
import SearchSuggestions from "./pages/tools-directory/search-suggestions.astro"

interface Props {
  action: string
  language: SiteLanguage
}

const { action, language } = Astro.props
const { catalog } = loadSiteMessages(language)
const { categories, searchLabel } = catalog.tools
const iconButton = buttonVariants({ variant: "ghost", size: "icon-sm" })
---

<navbar-search lang={language} class="contents">
  <button
    type="button"
    popovertarget="navbar-search"
    aria-label={searchLabel}
    class={cn(iconButton, "search-trigger")}
  >
    <span class="search-trigger-icon" aria-hidden="true"><Search /></span>
    <span class="search-close-icon" aria-hidden="true"><X /></span>
  </button>
  <form
    id="navbar-search"
    popover
    role="search"
    aria-label={searchLabel}
    action={action}
    method="get"
    data-search-form
    data-category-labels={JSON.stringify(categories)}
  >
    <div class="search-field flex items-center overflow-clip rounded-lg border border-input bg-popover text-popover-foreground shadow-sm focus-within:ring-2 focus-within:ring-ring/50">
      <Search aria-hidden="true" className="size-4 shrink-0" />
      <div class="search-entry flex h-full min-w-0 flex-1 items-center gap-1 pe-1">
        <input
          type="text"
          name="query"
          role="combobox"
          aria-label={searchLabel}
          aria-expanded="false"
          aria-controls="navbar-search-suggestions"
          aria-autocomplete="list"
          placeholder={searchLabel}
          inputmode="search"
          enterkeyhint="search"
          autocomplete="off"
          autofocus
          required
          class="h-full min-w-0 flex-1 ps-2 text-base outline-none placeholder:text-muted-foreground pointer-fine:md:text-sm"
        />
        <button type="button" data-search-clear hidden aria-label={catalog.tools.clearSearchLabel} class={iconButton}>
          <X aria-hidden="true" />
        </button>
        <button type="submit" aria-label={searchLabel} class={iconButton}>
          <ArrowRight aria-hidden="true" className="rtl:-scale-x-100" />
        </button>
      </div>
    </div>
    <SearchSuggestions id="navbar-search" messages={catalog.tools} compact />
  </form>
</navbar-search>

<style>
  @property --navbar-search-progress {
    syntax: "<number>";
    inherits: false;
    initial-value: 1;
  }

  .search-trigger,
  .search-close-icon,
  form {
    display: none;
  }

  @supports selector(:popover-open) {
    .search-trigger {
      display: inline-flex;
      anchor-name: --navbar-search-trigger;
      transition-property: background-color;
    }

    .search-trigger:has(+ :popover-open) .search-trigger-icon {
      display: none;
    }

    .search-trigger:has(+ :popover-open) .search-close-icon,
    form:popover-open {
      display: block;
    }
  }

  form {
    --navbar-search-progress: 1;
    --gutter: max(var(--spacing-page-x), (100% - 24rem) / 2);
    --trigger-size: 1.75rem;
    --field-height: 2.75rem;
    --expanded-width: calc(100% - 2 * var(--gutter));
    inset: auto;
    inset-block-start: calc(var(--spacing-page-y) + 4rem);
    inset-inline-end: var(--gutter);
    inline-size: var(--expanded-width);
    margin: 0;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
  }

  .search-field {
    block-size: var(--field-height);
    padding-inline-start: 0.3125rem;
  }

  @media (pointer: coarse) {
    .search-entry button {
      min-inline-size: 2.25rem;
      min-block-size: 2.25rem;
    }
  }

  @supports (inset-inline-end: anchor(end)) {
    form {
      position-anchor: --navbar-search-trigger;
      /* Resolve the anchor and viewport offsets at each animation step. */
      inset-block-start: calc(
        anchor(center) - var(--field-height) / 2 +
        ((var(--trigger-size) + var(--field-height)) / 2 + 0.5rem) * var(--navbar-search-progress)
      );
      inset-inline-end: calc(
        anchor(end) * (1 - var(--navbar-search-progress)) + var(--gutter) * var(--navbar-search-progress)
      );
      inline-size: calc(
        var(--trigger-size) + (var(--expanded-width) - var(--trigger-size)) * var(--navbar-search-progress)
      );
    }

    @media (width >= 48rem) and (pointer: fine) {
      .search-trigger:has(+ :popover-open) {
        opacity: 0;
      }

      form {
        --field-height: 2.25rem;
        --expanded-width: 20rem;
        inset-block-start: calc(anchor(center) - var(--field-height) / 2);
        inset-inline-end: anchor(end);
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      form {
        --expand: 220ms cubic-bezier(0.2, 0.75, 0.3, 1);
        transition: --navbar-search-progress var(--expand);
      }

      .search-field {
        transition: background-color var(--expand), border-color var(--expand), box-shadow var(--expand);
      }

      .search-entry {
        transition: opacity 120ms ease-out 60ms;
      }

      .search-close-icon {
        transition: opacity 120ms ease-out 80ms;
      }

      @starting-style {
        .search-trigger:has(+ :popover-open) .search-close-icon {
          opacity: 0;
        }

        form:popover-open {
          --navbar-search-progress: 0;
        }

        form:popover-open .search-field {
          background-color: transparent;
          border-color: transparent;
          box-shadow: none;
        }

        form:popover-open .search-entry {
          opacity: 0;
        }
      }
    }
  }
</style>

<script>
  import { loadToolSearchSuggestions } from "@workspace/tool-registry/search-suggestions"
  import { defineSearchElement, setupSearch } from "./pages/tools-directory/search-client"

  defineSearchElement("navbar-search", (root) => {
    const trigger = root.querySelector<HTMLButtonElement>("[popovertarget]")!
    const form = root.querySelector("form")!
    const search = setupSearch(root, {
      entries: null,
      loadEntries: () => loadToolSearchSuggestions(root.lang),
    })

    function updateTrigger() {
      trigger.tabIndex = form.matches(":popover-open") ? -1 : 0
    }

    form.addEventListener("toggle", updateTrigger)
    return () => {
      form.removeEventListener("toggle", updateTrigger)
      search.destroy()
    }
  })
</script>
