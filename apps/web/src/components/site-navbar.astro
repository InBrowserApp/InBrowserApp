---
import LanguageSwitcher from "./language-switcher.astro"
import NavbarSearch from "./navbar-search.astro"
import PwaInstallButton from "./pwa-install-button.astro"
import ThemeToggle from "./theme-toggle.astro"
import {
  createLanguageOptions,
  localizePath,
  type SiteLanguage,
} from "@/lib/site"
import { loadSiteMessages } from "@/lib/site-messages"

interface Props {
  language: SiteLanguage
  current: "home" | "tools" | "install"
  pathname: string
  availableLanguages?: readonly SiteLanguage[]
}

const { language, current, pathname, availableLanguages } = Astro.props
const { catalog } = loadSiteMessages(language)
const languageOptions = createLanguageOptions(
  pathname,
  language,
  availableLanguages
)
const toolsHref = localizePath("/tools", language)
---

<nav class="flex flex-wrap items-center justify-between gap-2">
  <div class="flex items-center gap-4">
    <a
      href={localizePath("/", language)}
      class="text-sm font-semibold text-foreground"
    >
      {catalog.site.name}
    </a>
    <a
      href={toolsHref}
      class:list={[
        "text-sm transition-colors hover:text-foreground",
        current === "tools" ? "text-foreground" : "text-muted-foreground",
      ]}
    >
      {catalog.site.navigation.tools}
    </a>
  </div>
  <div class="ms-auto flex items-center gap-1">
    <NavbarSearch language={language} action={toolsHref} />
    <div class="mx-1 hidden h-4 w-px bg-border supports-[selector(:popover-open)]:block" aria-hidden="true" />
    <PwaInstallButton label={catalog.site.installApp} href={localizePath("/install", language)} />
    <ThemeToggle
      labelLight={catalog.site.themeLight}
      labelDark={catalog.site.themeDark}
      labelSystem={catalog.site.themeSystem}
      srLabel={catalog.site.themeLabel}
    />
    <div class="mx-1 h-4 w-px bg-border" aria-hidden="true" />
    <LanguageSwitcher
      label={catalog.site.languageLabel}
      options={languageOptions}
    />
  </div>
</nav>
