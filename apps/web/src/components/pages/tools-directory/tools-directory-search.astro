---
import SearchCombobox from "./search-combobox.astro"
import type { SiteLanguage } from "@/lib/site"
import type { SearchMessages } from "./search-types"

interface Props {
  language: SiteLanguage
  messages: SearchMessages & Readonly<{
    resultCountSuffix: string
    emptyRegistryTitle: string
    categoryLabels: Readonly<Record<string, string>>
  }>
}
const { language, messages } = Astro.props
---

<directory-search lang={language} class="flex min-w-0 flex-col gap-4">
  <SearchCombobox id="directory-search" language={language} categoryLabels={messages.categoryLabels} messages={messages} />
  <p data-directory-status role="status" aria-live="polite" aria-atomic="true" aria-busy="false" data-registry={messages.emptyRegistryTitle} data-empty={messages.emptySearchTitle} data-suffix={messages.resultCountSuffix} class="text-sm text-muted-foreground sr-only"></p>
</directory-search>

<script>
  import { defineSearchElement } from "./search-client"
  import { setupDirectorySearch } from "./directory-client"
  defineSearchElement("directory-search", setupDirectorySearch)
</script>
