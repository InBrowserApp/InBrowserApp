---
import { getCategoryLabel, type ToolCategoryCount } from "@/lib/tool-directory"
import { localizePath, type SiteLanguage } from "@/lib/site"

interface Props {
  counts: readonly ToolCategoryCount[]
  totalCount: number
  selected: string | null
  language: SiteLanguage
  labels: Readonly<Record<string, string>>
  allLabel: string
  categoriesLabel: string
  variant: "sidebar" | "chips"
}

const { counts, totalCount, selected, language, labels, allLabel, categoriesLabel, variant } = Astro.props
const options = [
  { category: null, count: totalCount, label: allLabel },
  ...counts.map(({ category, count }) => ({ category, count, label: getCategoryLabel(labels, category) })),
]
const numberFormat = new Intl.NumberFormat(language)
---

{variant === "sidebar" ? (
  <nav aria-label={categoriesLabel} class="hidden lg:sticky lg:top-8 lg:block">
    <p class="mb-2 px-2.5 text-[11px] font-semibold tracking-[0.15em] text-muted-foreground uppercase">{categoriesLabel}</p>
    <ul class="flex list-none flex-col gap-0.5 ps-0">
      {options.map(({ category, count, label }) => (
        <li>
          <a
            href={localizePath(category ? `/categories/${category}` : "/tools", language)}
            aria-current={selected === category ? "page" : undefined}
            class:list={[
              "flex w-full items-center justify-between gap-2 rounded-lg px-2.5 py-1.5 text-start text-sm transition-colors",
              selected === category ? "bg-muted font-medium text-foreground" : "text-foreground/70 hover:bg-muted/60 hover:text-foreground",
            ]}
          >
            <span class="truncate">{label}</span>
            <span class="shrink-0 text-sm font-normal text-foreground/70">{numberFormat.format(count)}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
) : (
  <nav data-category-chips aria-label={categoriesLabel} class="-mx-1 flex gap-2 overflow-x-auto px-1 pb-1 lg:hidden">
    {options.map(({ category, count, label }) => (
      <a
        href={localizePath(category ? `/categories/${category}` : "/tools", language)}
        aria-current={selected === category ? "page" : undefined}
        class:list={[
          "inline-flex h-7.5 shrink-0 items-center gap-1.5 rounded-full border px-3 text-[13px] whitespace-nowrap transition-colors",
          selected === category ? "border-transparent bg-primary font-medium text-primary-foreground" : "border-border text-foreground hover:bg-muted/60",
        ]}
      >
        {label}
        <span class:list={{ "text-muted-foreground": selected !== category }}>{numberFormat.format(count)}</span>
      </a>
    ))}
  </nav>
)}
