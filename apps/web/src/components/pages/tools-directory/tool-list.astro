---
import { ToolIcon } from "@workspace/ui/components/tool/tool-icon"
import { localizePath, type SiteLanguage } from "@/lib/site"
import { getCategoryLabel, type DirectoryToolEntry } from "@/lib/tool-directory"

interface Props {
  entries: readonly DirectoryToolEntry[]
  language: SiteLanguage
  categoryLabels: Readonly<Record<string, string>>
  showCategory: boolean
}
const { entries, language, categoryLabels, showCategory } = Astro.props
---

<div data-tool-list hidden={entries.length === 0} class="overflow-hidden rounded-xl border border-border">
  {entries.map((entry, index) => (
    <a
      data-tool-row={entry.slug}
      data-category={entry.category}
      data-first-visible={index === 0 ? "" : undefined}
      href={localizePath(`/tools/${entry.slug}`, language)}
      class="flex items-center gap-3.5 border-t border-border/70 px-4 py-3.5 transition-colors hover:bg-muted/50 data-first-visible:border-t-0 sm:px-4.5"
    >
      <ToolIcon icon={entry.icon} className="size-4 shrink-0 text-muted-foreground" />
      <span class="flex min-w-0 flex-1 flex-col gap-0.5 md:flex-row md:items-center md:gap-3.5">
        <span data-tool-name class="truncate text-[15px] font-medium tracking-[-0.02em] md:w-56 md:shrink-0">{entry.name}</span>
        <span data-tool-description class="truncate text-[13px] text-muted-foreground md:min-w-0 md:flex-1">{entry.description}</span>
      </span>
      {showCategory && <span class="hidden shrink-0 text-[10px] font-medium tracking-[0.12em] text-foreground/70 uppercase md:inline">{getCategoryLabel(categoryLabels, entry.category)}</span>}
    </a>
  ))}
</div>
