---
import { toolSearchIndex } from "@workspace/tool-registry"
import MainLayout from "@/layouts/main.astro"
import PageBreadcrumbs from "@/components/page-breadcrumbs.astro"
import ToolsDirectorySearch from "@/components/pages/tools-directory/tools-directory-search.astro"
import CategoryNav from "@/components/pages/tools-directory/category-nav.astro"
import DirectoryEmptyState from "@/components/pages/tools-directory/directory-empty-state.astro"
import ToolList from "@/components/pages/tools-directory/tool-list.astro"
import { rankToolEntries } from "@/components/pages/tools-directory/search-core"
import { formatSiteMessage, loadSiteMessages } from "@/lib/site-messages"
import { createPageSeo } from "@/lib/seo"
import {
  countToolsByCategory,
  getCategoryLabel,
  getToolCategories,
  toDirectoryEntries,
} from "@/lib/tool-directory"
import type { SiteLanguage } from "@/lib/site"

interface Props {
  language: SiteLanguage
  category?: string
}

const { language, category } = Astro.props
const { catalog } = loadSiteMessages(language)
const categoryCounts = countToolsByCategory(toolSearchIndex)
const selectedTools = category
  ? toolSearchIndex.filter((entry) => getToolCategories(entry).includes(category))
  : toolSearchIndex

if (category && selectedTools.length === 0) {
  throw new Error(`Unknown or empty tool category '${category}'.`)
}

const heading = category
  ? formatSiteMessage(catalog.categoryPages.titleTemplate, {
      category: getCategoryLabel(catalog.tools.categories, category),
    })
  : catalog.tools.title
const description = category
  ? catalog.categoryPages.descriptions[category]
  : catalog.metadata.toolsDescription

if (!description) {
  throw new Error(`Missing category description for '${category}' in '${language}'.`)
}

const pathname = category ? `/categories/${category}` : "/tools"
const seo = createPageSeo({
  description,
  language,
  pathname,
  title: category ? `${heading} — ${catalog.site.name}` : catalog.metadata.toolsTitle,
})
const entries = toDirectoryEntries(selectedTools, language)
const toolCount = new Intl.NumberFormat(language).format(entries.length)
const searchMessages = {
  categoryLabels: catalog.tools.categories,
  clearSearchLabel: catalog.tools.clearSearchLabel,
  emptyRegistryTitle: catalog.tools.emptyRegistryTitle,
  emptySearchDescription: catalog.tools.emptySearchDescription,
  emptySearchTitle: catalog.tools.emptySearchTitle,
  resultCountSuffix: catalog.tools.resultCountSuffix,
  searchLabel: catalog.tools.searchLabel,
  searchPlaceholder: formatSiteMessage(catalog.tools.searchPlaceholder, {
    count: toolCount,
  }),
  suggestionMatchCount: catalog.tools.suggestionMatchCount,
  suggestionMatchCountOne: catalog.tools.suggestionMatchCountOne,
  suggestionsHint: catalog.tools.suggestionsHint,
  suggestionsLabel: catalog.tools.suggestionsLabel,
}
const categoryNavProps = {
  allLabel: catalog.tools.categoryAll,
  categoriesLabel: catalog.tools.categoriesLabel,
  counts: categoryCounts,
  labels: catalog.tools.categories,
  language,
  selected: category ?? null,
  totalCount: toolSearchIndex.length,
}
---

<MainLayout
  alternateLinks={seo.alternateLinks}
  canonicalUrl={seo.canonicalUrl}
  description={seo.description}
  lang={language}
  title={seo.title}
  current="tools"
  pathname={pathname}
>
  <header class="flex max-w-3xl flex-col gap-3">
    {category && (
      <PageBreadcrumbs language={language} items={[
        { label: catalog.tools.categoryAll, pathname: "/tools" },
        { label: getCategoryLabel(catalog.tools.categories, category), pathname },
      ]} />
    )}
    <h1 class="font-heading text-3xl leading-tight tracking-[var(--tracking-display)] text-balance sm:text-4xl">{heading}</h1>
    <p class="text-base leading-7 text-muted-foreground">{description}</p>
  </header>

  <div data-tools-directory class="grid items-start gap-6 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-10">
    <CategoryNav {...categoryNavProps} variant="sidebar" />
    <div class="flex min-w-0 flex-col gap-4">
      <CategoryNav {...categoryNavProps} variant="chips" />
      <ToolsDirectorySearch language={language} messages={searchMessages} />
      <ToolList
        entries={rankToolEntries(entries, "", language)}
        language={language}
        categoryLabels={catalog.tools.categories}
        showCategory={!category}
      />
      <div data-tool-empty hidden={entries.length !== 0}>
        <DirectoryEmptyState
          icon={entries.length === 0 ? "registry" : "search"}
          title={entries.length === 0 ? catalog.tools.emptyRegistryTitle : catalog.tools.emptySearchTitle}
          description={entries.length === 0 ? catalog.tools.emptyRegistryDescription : catalog.tools.emptySearchDescription}
        />
      </div>
    </div>
  </div>
</MainLayout>
