---
import { buttonVariants } from "@workspace/ui/components/ui/button"
import { MonitorDown } from "@workspace/ui/icons"
import { cn } from "@workspace/ui/lib/utils"

interface Props {
  label: string
}

const { label } = Astro.props
---

<div data-pwa-install hidden class="flex items-center gap-1">
  <details>
    <summary
      data-pwa-install-trigger
      role="button"
      aria-label={label}
      aria-describedby="pwa-install-tooltip"
      class={cn(
        buttonVariants({ variant: "ghost", size: "icon-sm" }),
        "group/pwa-install relative list-none aria-disabled:[&_svg]:opacity-50 [&::-webkit-details-marker]:hidden"
      )}
    >
      <MonitorDown />
      <span
        id="pwa-install-tooltip"
        role="tooltip"
        class="pointer-events-none invisible absolute end-0 top-full mt-2 rounded-md bg-foreground px-2 py-1 text-xs whitespace-nowrap text-background opacity-0 transition-opacity group-hover/pwa-install:visible group-hover/pwa-install:opacity-100 group-focus-visible/pwa-install:visible group-focus-visible/pwa-install:opacity-100"
      >
        {label}
      </span>
    </summary>
  </details>
  <div class="mx-1 h-4 w-px bg-border" aria-hidden="true" />
</div>
