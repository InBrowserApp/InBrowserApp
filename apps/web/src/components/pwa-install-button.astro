---
import { Button } from "@workspace/ui/components/ui/button"
import { Download } from "@workspace/ui/icons"

interface Props {
  label: string
}

const { label } = Astro.props
---

<Button
  type="button"
  data-pwa-install
  hidden
  variant="outline"
  aria-label={label}
  title={label}
>
  <Download data-icon="inline-start" />
  <span class="hidden sm:inline">{label}</span>
</Button>
