{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortTailwindcss": {
    "stylesheet": "packages/ui/src/styles/globals.css",
    "functions": ["cn", "cva"]
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    ".turbo/",
    ".agents/",
    ".playwright-cli/",
    "coverage/",
    "tools/html-viewer/fixtures/",
    "tools/html-to-pdf-converter/fixtures/",
    "tools/pdf-to-pdfa-converter/engine/generated/fynepdf.mjs",
    "pnpm-lock.yaml",
    "packages/lib/mac-address/data/registry.json",
    ".pnpm-store/",
    "CHANGELOG.md",
    "tools/tldr/commands.json"
  ]
}
